# SameVoice R&D — never commit real secrets.

# Runtime
APP_ENV=development
LOG_LEVEL=info

# Web / API
HOST=0.0.0.0
PORT=3000
PUBLIC_ORIGIN=

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# External baseline providers
DEEPGRAM_API_KEY=
GEMINI_API_KEY=
CARTESIA_API_KEY=

# Provider routing
STT_PROVIDER=deepgram
MT_PROVIDER=gemini
TTS_PROVIDER=cartesia
PREDICTOR_PROVIDER=local

# Local GPU services
PREDICTOR_URL=http://predictor:8101
ACOUSTIC_SCOUT_URL=http://acoustic-scout:8102
LOCAL_MT_URL=http://local-mt:8103
LOCAL_TTS_URL=http://local-tts:8104

# GPU placement for a 2x4090 R&D node
PREDICTOR_CUDA_VISIBLE_DEVICES=0
TTS_CUDA_VISIBLE_DEVICES=1

# Persistence
DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_URL=
MODEL_DIR=/workspace/models
CHECKPOINT_DIR=/workspace/checkpoints
DATASET_DIR=/workspace/datasets
BENCHMARK_DIR=/workspace/benchmarks
HF_HOME=/workspace/hf-cache

# Research toggles
ENABLE_SPECULATIVE_PREDICTION=false
ENABLE_ACOUSTIC_PRUNING=false
ENABLE_SPECULATIVE_MT=false
ENABLE_SPECULATIVE_TTS=false
ENABLE_LATENCY_DEBT_CONTROL=false

# Privacy / data collection
ENABLE_RESEARCH_DATA_COLLECTION=false
CONSENT_VERSION=
