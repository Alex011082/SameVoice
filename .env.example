# SpeakEasy — single source of truth for every environment variable.
#
#   cp .env.example .env && node scripts/check-env.mjs
#
# The defaults below are a COMPLETE, WORKING, KEYLESS configuration: local
# LiveKit SFU + mock STT/MT/TTS. No accounts, no GPU, no Docker required.
# Real-provider values are left blank on purpose — filling one in does nothing
# until you also switch the matching *_PROVIDER line.
#
# Consumers: backend (dotenv), agent (python-dotenv), web (vite, envDir=repo
# root — vite only exposes keys prefixed with VITE_), scripts/*.sh (sourced).
# Because the shell scripts `source` this file, values must not contain spaces
# unless they are quoted.


# =============================================================================
# Transport profile — THE switch between "two tabs on this Mac" and
#                     "two people on two machines on two networks"
# =============================================================================
#
#   local  — livekit-server runs on this Mac (scripts/livekit.sh starts it),
#            the browser is on http://localhost:5173, everything is loopback.
#            Zero accounts. This is the default and it must always work.
#
#   cloud  — LiveKit Cloud is the SFU (wss://, no local server is started) and
#            the web page is served through a public HTTPS origin (a Cloudflare
#            quick tunnel in front of the Vite dev server, see `npm run tunnel`).
#            Needed because getUserMedia refuses to run on http://<LAN-IP>, so a
#            second tester on another machine cannot grant microphone access
#            without a real https origin.
#
# Nothing else in the repo needs to change between the two: the LiveKit URL and
# token reach the browser at runtime in the POST /api/calls/:id/join response,
# and reach the agent in the POST /jobs payload. It is genuinely .env-only.
#
# scripts/check-env.mjs validates the profile in force and refuses the
# combinations that fail silently later (ws:// in cloud, http:// public origin,
# committed dev keys against LiveKit Cloud).
#
# Override for one run without editing this file:
#   SPEAKEASY_PROFILE=cloud npm run dev
SPEAKEASY_PROFILE=local

# CLOUD ONLY. The public https origin that serves the web page — exactly what
# `npm run tunnel` prints, e.g. https://four-random-words.trycloudflare.com
# No trailing slash, no path.
#
# Who reads it (verified against the source, 2026-08-23):
#   * scripts/dev.sh      — prints the two identity URLs and the link to send to
#                           the second tester;
#   * scripts/check-env.mjs — enforces https, no path, no trailing slash in the
#                           cloud profile.
# NOTHING ELSE. In particular the backend does NOT read this variable: its CORS
# allowlist is built from WEB_ORIGINS (backend/src/config.ts) plus the local
# origins. If you ever expose the API on its own origin, the public page origin
# has to be repeated in WEB_ORIGINS — setting PUBLIC_WEB_ORIGIN alone changes
# nothing about CORS. With the recommended single-tunnel setup (Vite proxies
# /api and /healthz to 127.0.0.1:8787) the page and the API share one origin, so
# no CORS check ever runs and this value is used for the banner only.
#
# Leave BLANK in the local profile. A Cloudflare quick tunnel gets a NEW random
# hostname on every start, so this line is re-pasted once per session.
PUBLIC_WEB_ORIGIN=


# =============================================================================
# LiveKit transport
# =============================================================================

# ws:// for the local self-hosted SFU, wss:// for LiveKit Cloud.
# Anything that is not localhost/127.0.0.1 makes scripts/livekit.sh skip
# starting a local server (Cloud mode). An https:// web page CANNOT open a
# ws:// signal connection — TLS must be all-or-nothing across web + LiveKit.
#
# LOCAL:  ws://127.0.0.1:7880
# CLOUD:  wss://<your-project>.livekit.cloud   (LiveKit Cloud dashboard, top of
#         the project page). Regional pinning, if you ever want to force the EU
#         edge explicitly: wss://<subdomain>.eu-central.rtc.livekit.cloud
LIVEKIT_URL=ws://127.0.0.1:7880

# MUST match the `keys:` map in livekit.yaml byte for byte. Declaring `keys:`
# in a config file suppresses livekit-server's automatic devkey injection, so a
# mismatch here rejects every token with an opaque auth error.
# For LiveKit Cloud: Settings -> Keys -> Create key. The SECRET IS SHOWN ONCE.
LIVEKIT_API_KEY=devkey

# A secret shorter than 32 characters makes livekit-server log a scary
# (non-fatal) ERROR line. This one is 43 characters.
# For LiveKit Cloud, paste the project's key/secret instead.
LIVEKIT_API_SECRET=devsecret0000000000000000000000000000000000


# =============================================================================
# Backend (Fastify, Node)
# =============================================================================

# Listen port.
BACKEND_PORT=8787

# Bind address. 0.0.0.0 so LAN devices can reach it; 127.0.0.1 to keep the
# control plane on this machine only.
BACKEND_HOST=0.0.0.0

# Cosmetic only: the URL scripts/dev.sh prints in its start-up banner. No
# service reads it — the browser learns the backend address from
# VITE_BACKEND_URL, and GET /api/config does not echo this value.
BACKEND_PUBLIC_URL=http://127.0.0.1:8787

# Lifetime of a participant JWT minted by POST /api/calls/:callId/join.
TOKEN_TTL_SECONDS=3600


# =============================================================================
# Web (Vite)
# =============================================================================

# The only backend URL the browser ever sees. Must be VITE_-prefixed to be
# exposed to client code.
#
# LOCAL:  http://127.0.0.1:8787
# CLOUD:  /            <- a single slash, meaning "same origin as the page".
#         web/src/api.ts strips trailing slashes, so "/" becomes "" and every
#         call becomes a relative fetch (/api/config, /api/calls, /healthz)
#         which the Vite dev server proxies to 127.0.0.1:8787. That is what
#         keeps the cloud profile down to ONE public URL and ONE tunnel, and it
#         is why the backend's CORS allowlist never comes into play: browsers
#         do not run CORS checks on same-origin requests.
#
# An https:// absolute URL is also accepted in the cloud profile (two tunnels,
# one for web and one for the API) — but then the page origin must be listed in
# WEB_ORIGINS (that, not PUBLIC_WEB_ORIGIN, is what the backend's CORS allowlist
# is built from) and both tunnel URLs change on every restart.
# http:// is REFUSED in the cloud profile: an https page cannot fetch http.
VITE_BACKEND_URL=http://127.0.0.1:8787

# Vite dev-server port. Also the port `npm run tunnel` points cloudflared at,
# and the port the backend logs as the expected web origin.
WEB_PORT=5173


# =============================================================================
# Agent (aiohttp job server, Python)
# =============================================================================

# Port the agent's control API listens on.
AGENT_PORT=8788

# Bind address for that API. 127.0.0.1 — the agent is never addressed by a
# browser, only by the backend on the same machine. This does NOT change in the
# cloud profile: the agent dials OUT to LiveKit Cloud (TCP 443 signalling, UDP
# 3478/50000-60000 media, TURN-over-TLS on 443 as fallback), so it needs no
# public address and no inbound port. NEVER tunnel the agent — /jobs is guarded
# only by the shared secret below.
AGENT_HOST=127.0.0.1

# Where the backend dispatches translation jobs. The backend contacts this ONLY
# when the decided call mode is not DIRECT; that is the core product principle.
AGENT_URL=http://127.0.0.1:8788

# Sent by the backend as `x-speakeasy-agent-key`, validated by the agent.
# A mismatch is a 401. Change this for anything beyond localhost.
AGENT_SHARED_SECRET=dev-agent-secret


# =============================================================================
# Ringing / presence — so the callee sees "Alex is calling" instead of needing
#                      an invite link pasted over WhatsApp
# =============================================================================
# Deliberately poll-based: no websockets are added to the backend. Two testers
# at 2 requests/second is nothing, and polling cannot half-fail the way a
# dropped socket does.

# WARNING — this variable is currently READ BY NOTHING. It is kept only so that
# check-env.mjs has a number to sanity-check PRESENCE_TTL_SECONDS against, and
# so removing it does not make check-env warn about an unknown key in existing
# .env files. Verified 2026-08-23: no TypeScript, Python or shell file reads it.
#
# What actually decides the cadence, and where it lives:
#   * the browser uses FIXED constants in web/src/ring.ts — 1200 ms while
#     something is ringing, 2500 ms idle, 5000 ms in a hidden tab;
#   * the backend advertises `ring.pollIntervalMs` in GET /api/config from
#     PRESENCE_POLL_MS (default 2000, not listed in this file), and the client
#     currently ignores that value — it only checks that the `ring` block
#     exists at all, to detect an older backend.
# So changing this number changes nothing except the check-env warning below.
VITE_POLL_INTERVAL_MS=2000

# How long a user is still considered online after their last poll.
# The number that matters is the SLOWEST real poll, which is the hidden-tab
# interval of 5000 ms in web/src/ring.ts — not VITE_POLL_INTERVAL_MS above.
# Keep this at >= 3x that, i.e. >= 15 s, or a tester whose tab is in the
# background flickers offline and the caller sees her go grey mid-ring.
PRESENCE_TTL_SECONDS=15

# How long an unanswered call keeps ringing before the backend gives up and
# marks it missed. Long enough to walk to the laptop, short enough that a
# forgotten ring does not hold a room open.
RING_TIMEOUT_SECONDS=45


# =============================================================================
# Call archive — where finished calls are kept
# =============================================================================
# The backend's call store is in memory. Until 25.08.2026 nothing in it ever
# expired, and a call created the previous evening was still live the next
# morning — that is what broke the two-person test (docs/07-product-spec.md §10).
#
# Now a call is bounded on both ends. The bounds themselves are constants in
# backend/src/ringing.ts, not environment variables, because they are product
# decisions rather than deployment ones:
#   * a call NOBODY joined ends after 10 minutes idle;
#   * a call somebody joined ends 3 hours after it was created (the browser
#     never tells the server "I closed the tab", so this is a ceiling, not a
#     duration policy);
#   * 10 minutes after it ends, the record leaves memory for the archive below.
#
# Nothing is deleted: an ended call is the record of a conversation two people
# had, and it is readable by exactly those two through
# GET /api/users/:userId/calls[/:callId]. On disk rather than in memory because
# the backend is restarted often and an archive a restart empties is not an
# archive. One JSON file per call; gitignored, like logs/calls.
#
# A relative path is anchored to the REPO root, not to the working directory of
# whatever started the process — the same trap EVAL_LOG_DIR documents below.
CALL_ARCHIVE_DIR=logs/archive


# =============================================================================
# Identity store — where profiles, contacts and the phone index live
# =============================================================================
# The four seeded test identities are code: every boot recreates them. Everyone
# who signed in with a phone number was only ever in memory, so `systemctl
# restart` deleted them — the founder's own profile came back as "user not
# found" through his ?me= link while the seeded four kept working, which is why
# it read as a broken link instead of a wiped store.
#
# One JSON snapshot, `identities.json`, rewritten on every change: a profile
# created or edited, a contact's per-contact override changed. Written to a
# temporary file and renamed, so a crash mid-write leaves the whole previous
# snapshot rather than a truncated one; a file that cannot be parsed stops the
# backend with the path instead of starting with an empty store.
#
# PERSONAL DATA — the file contains phone numbers, because that index is what
# keeps one number from minting a new profile at every login. It belongs under
# data/, which .gitignore covers twice (`data/` and `data/identity/`). Do not
# move it into a tracked directory, do not copy it into a bug report.
#
# A relative path is anchored to the REPO root, same as CALL_ARCHIVE_DIR above.
IDENTITY_DIR=data/identity


# =============================================================================
# Eval log — the bilingual-judge feature
# =============================================================================
# Every translated utterance is appended to logs/calls/<callId>.jsonl with the
# source transcript, the produced translation, both genders, the tone, every
# latency the pipeline measures, the provider triple in force, and a stable
# utterance id. A tester can then flag any utterance as WRONG in one click and
# the verdict lands in the same file against the same utterance id.
#
# This works in mock mode too, on purpose: the whole judging flow is testable
# offline before any vendor key exists.
#
# Read it back with:
#   cd agent && uv run python scripts/review_call.py <callId>
# NOT with `npm run review` — that wrapper reads a different set of field names
# than the agent writes and prints an empty report (docs/04-runbook.md, §12.3).

# true | false. Turning this off throws away the only labelled data this
# project produces. Off is for perf work, not for calls with a human on the
# other end.
EVAL_LOG_ENABLED=true

# Directory for the per-call JSONL files, relative to the repo root.
# NOTE: `npm run clean:logs` deliberately does NOT delete this directory — see
# .gitignore for why the data is kept on disk but never committed.
EVAL_LOG_DIR=logs/calls


# =============================================================================
# Provider selection — the switch between mock / cloud / RunPod
# =============================================================================
# Each stage is independent: you can run real STT with mock MT and TTS.
# The backend reads these for display only (GET /api/config); the agent's
# provider registry is the thing that actually acts on them.
#
#   STT_PROVIDER : mock | deepgram | runpod
#   MT_PROVIDER  : mock | gemini   | openai   | runpod
#   TTS_PROVIDER : mock | cartesia | runpod
#
# `runpod` adapters exist as Stage-1 stubs and raise NotImplementedError.
# Mock providers exercise mechanics only (VAD gating, chunk cadence,
# partial-vs-final contract, backpressure, TTS cancellation). Never judge
# translation or UX quality from mock output.
#
# Flip these ONE AT A TIME on the first real run — each stage is independent by
# design, and isolating them is the only way to attribute a failure to the
# right vendor.
STT_PROVIDER=mock
MT_PROVIDER=mock
TTS_PROVIDER=mock


# =============================================================================
# STT — Deepgram (only read when STT_PROVIDER=deepgram)
# =============================================================================

DEEPGRAM_API_KEY=

# nova-3 is the only Deepgram model with both Hebrew and Russian in true
# streaming. Do NOT switch this to flux-* — Flux supports neither language.
DEEPGRAM_MODEL=nova-3

# Regional endpoint. Measured from Israel on 2026-08-24: the vendor default
# api.deepgram.com is 233 ms TCP connect (it resolves to San Jose), the EU
# endpoint 84 ms (AWS eu-central-1). Streaming STT is serial in the media path,
# so that ~150 ms comes straight off the perceived delay. EU is the default
# because every user is in Israel — change it for users elsewhere.
# If auth fails against the EU host, the account may be US-provisioned: fall
# back to https://api.deepgram.com/v1/listen and re-measure before concluding
# anything about latency.
DEEPGRAM_BASE_URL=https://api.eu.deepgram.com/v1/listen


# =============================================================================
# MT — Gemini (only read when MT_PROVIDER=gemini)
# =============================================================================

GEMINI_API_KEY=

# Called over raw HTTPS generateContent; the agent adds no SDK.
# Billing MUST be enabled on the Google Cloud project behind this key: the free
# tier permits Google to train on the content of the call, and its rate limit
# sits below this pipeline's sustained request rate.
# ЗАМЕРЕНО 25.08.2026 на живых фразах из первого удачного звонка:
#   gemini-3.7-flash       ~1250 мс, иврит ВЕРНЫЙ (женский единственный род)
#   gemini-3.5-flash-lite   ~750 мс, иврит СЛОМАН: женское множественное там,
#                                    где промпт требует единственное, и одна
#                                    фраза целиком выдана по-арабски
# Быстрее — не значит лучше: flash-lite быстро промахивается.
GEMINI_MODEL=gemini-3.5-flash-lite

# Допустимые значения РАЗНЫЕ у разных моделей, неверное — жёсткий HTTP 400:
#   gemini-3.5-flash-lite : minimal | low | medium | high
#   gemini-3.7-flash      : low | medium | high        (minimal НЕ принимает)
# Ставить самый низкий, который модель принимает: токены размышления
# тарифицируются как выход И тратятся до первого слышимого слова.
GEMINI_THINKING_LEVEL=low

# =============================================================================
# MT — OpenAI (only read when MT_PROVIDER=openai)
# =============================================================================

OPENAI_API_KEY=

# Called over the raw Responses API (/v1/responses), not Chat Completions:
# `reasoning.effort` is only settable there, and on a reasoning model that is
# the most important knob we have — reasoning tokens are billed as OUTPUT and
# are spent BEFORE the first visible token, which on a live call is dead air.
# The provider pins effort to "none"; see providers/mt_openai.py.
#
# MEASURED 24.08.2026 (Tel Aviv -> OpenAI, real fragments from the first live
# call), because the price tiers are a trap:
#   gpt-5.6-luna  $0.20 / $1.20 per 1M  — comparable to Gemini Flash-Lite
#   gpt-5.6-sol   $5.00 / $30.00 per 1M — 33x input, 24x output. NOT for the
#                                         call path: MT would go from the
#                                         cheapest line item to the most
#                                         expensive, ~$0.06/min vs ~$0.002/min.
# Latency is the real cost here: luna measured ~1.3 s median / ~1.9 s worst,
# against 680-770 ms for gemini-3.5-flash-lite in production. The corridor for
# the whole pipeline is 1.5-2.5 s, so this roughly doubles the MT budget.
OPENAI_MODEL=gpt-5.6-luna


# =============================================================================
# TTS — Cartesia (only read when TTS_PROVIDER=cartesia)
# =============================================================================

CARTESIA_API_KEY=

# Pinned snapshot, not the rolling `sonic-3.5` id: Hebrew quality must not be
# able to change without a deploy.
CARTESIA_MODEL=sonic-3.5-2026-05-04

# Cartesia voice ids per language. BLANK IS NOT "the default voice for that
# language" — `voice` is a required field in Cartesia's API, so leaving these
# empty makes the plugin fall back to its own hardcoded en-US female voice
# ("Katie") for BOTH languages and BOTH speakers. Fill them in before any call
# with a human on the other end.
#
#   CARTESIA_VOICE_HE — speaks Alex's (male) words to Noa  -> pick a MALE voice
#   CARTESIA_VOICE_RU — speaks Noa's (female) words to Alex -> pick a FEMALE voice
#
# Cartesia voices are language-agnostic: any voice id works with any language,
# so these must be chosen by listening to Hebrew/Russian samples in the
# playground, not by looking for a voice tagged with the language.
CARTESIA_VOICE_RU=
CARTESIA_VOICE_HE=


# =============================================================================
# RunPod — Stage-1 self-hosted tier (stubs today)
# =============================================================================

RUNPOD_STT_URL=
RUNPOD_MT_URL=
RUNPOD_TTS_URL=


# =============================================================================
# Chunker tuning (agent) — when a stable source prefix becomes a spoken unit
# =============================================================================
# A unit is committed on the FIRST of: strong clause boundary, weak boundary
# with >= CHUNK_WEAK_BOUNDARY_MIN_WORDS stable words, >= CHUNK_MIN_WORDS stable
# words not ending on a function word, >= CHUNK_MAX_SILENCE_MS of silence, or
# CHUNK_TIMEOUT_MS elapsed. Committed text is never re-translated.

CHUNK_MIN_WORDS=8
CHUNK_MAX_SILENCE_MS=300
CHUNK_TIMEOUT_MS=2200

# A weak boundary (comma, conjunction) only commits once this many stable words
# have accumulated — it stops the chunker firing on two-word fragments.
CHUNK_WEAK_BOUNDARY_MIN_WORDS=4

# How many committed (source, translation) pairs are replayed to the MT stage
# as rolling context. Higher = better pronoun/register consistency, more tokens.
MT_HISTORY_TURNS=4


# =============================================================================
# Logging
# =============================================================================

# debug | info | warn | error — read by both backend and agent.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# SameVoice speculative R&D / RunPod additions
# ---------------------------------------------------------------------------
PREDICTOR_PROVIDER=local
PREDICTOR_URL=http://127.0.0.1:8101
ACOUSTIC_SCOUT_URL=http://127.0.0.1:8102
LOCAL_MT_URL=http://127.0.0.1:8103
LOCAL_TTS_URL=http://127.0.0.1:8104
PREDICTOR_CUDA_VISIBLE_DEVICES=0
TTS_CUDA_VISIBLE_DEVICES=1
MODEL_DIR=/workspace/models
CHECKPOINT_DIR=/workspace/checkpoints
DATASET_DIR=/workspace/datasets
BENCHMARK_DIR=/workspace/benchmarks
HF_HOME=/workspace/hf-cache
ENABLE_SPECULATIVE_PREDICTION=false
ENABLE_ACOUSTIC_PRUNING=false
ENABLE_SPECULATIVE_MT=false
ENABLE_SPECULATIVE_TTS=false
ENABLE_LATENCY_DEBT_CONTROL=false
ENABLE_RESEARCH_DATA_COLLECTION=false
CONSENT_VERSION=
