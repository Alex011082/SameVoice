ARG CUDA_BASE=nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
FROM ${CUDA_BASE}

ARG DEBIAN_FRONTEND=noninteractive
ARG INSTALL_GPU_ENGINES=0
ARG INSTALL_TTS_ENGINE=0
ENV TZ=Etc/UTC \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    UV_LINK_MODE=copy \
    HF_HOME=/workspace/hf-cache \
    TORCH_HOME=/workspace/torch-cache \
    XDG_CACHE_HOME=/workspace/cache \
    UV_CACHE_DIR=/workspace/uv-cache \
    MODEL_DIR=/workspace/models \
    CHECKPOINT_DIR=/workspace/checkpoints \
    DATASET_DIR=/workspace/datasets \
    BENCHMARK_DIR=/workspace/benchmarks \
    CALL_ARCHIVE_DIR=/workspace/logs/archive \
    EVAL_LOG_DIR=/workspace/logs/calls \
    BACKEND_HOST=0.0.0.0 \
    AGENT_HOST=127.0.0.1 \
    WEB_PORT=5173 \
    BACKEND_PORT=8787 \
    AGENT_PORT=8788

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        curl \
        ffmpeg \
        git \
        gnupg \
        libsndfile1 \
        tini \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && node --version \
    && npm --version

# Pin uv as well as application dependencies. The application agent stays on
# Python 3.13. GPU model services use isolated Python 3.11 environments so
# inference-library pins cannot destabilise the call relay or each other.
ARG UV_VERSION=0.10.0
RUN curl -LsSf "https://astral.sh/uv/${UV_VERSION}/install.sh" | env UV_INSTALL_DIR=/usr/local/bin sh \
    && uv --version \
    && uv python install 3.13

WORKDIR /opt/samevoice

# Dependency layers are intentionally separate from the source copy so normal
# code edits do not force every npm/Python dependency to be downloaded again.
COPY backend/package.json backend/package-lock.json backend/
COPY web/package.json web/package-lock.json web/
COPY agent/pyproject.toml agent/uv.lock agent/README.md agent/
COPY gpu/think-requirements.txt gpu/think-requirements.txt
COPY gpu/tts-requirements.txt gpu/tts-requirements.txt

RUN npm --prefix backend ci --no-audit --no-fund \
    && npm --prefix web ci --no-audit --no-fund \
    && cd agent \
    && uv sync --frozen --python 3.13 --extra api --no-install-project

# Normal CI leaves both optional flags at 0. Manual RunPod-image builds can bake
# the heavy software into the image before paid Pod time. Model WEIGHTS remain
# excluded and populate the persistent /workspace cache only at runtime.
RUN if [ "$INSTALL_GPU_ENGINES" = "1" ]; then \
      uv python install 3.11 \
      && uv venv --python 3.11 /opt/venvs/think \
      && uv pip install --python /opt/venvs/think/bin/python -r gpu/think-requirements.txt; \
    else \
      echo "Skipping optional GPU0 THINK dependencies"; \
    fi

RUN if [ "$INSTALL_TTS_ENGINE" = "1" ]; then \
      uv python install 3.11 \
      && uv venv --python 3.11 /opt/venvs/speak \
      && uv pip install --python /opt/venvs/speak/bin/python -r gpu/tts-requirements.txt; \
    else \
      echo "Skipping optional GPU1 TTS dependencies"; \
    fi

COPY . .

# Install the local agent project after its source exists, then compile the Node
# services. The browser talks to /api on the same origin; Vite preview proxies
# those requests to the backend inside this container.
RUN cd agent \
    && uv sync --frozen --python 3.13 --extra api \
    && cd /opt/samevoice \
    && npm --prefix backend run build \
    && VITE_BACKEND_URL=/ npm --prefix web run build \
    && chmod +x docker/entrypoint.sh docker/healthcheck.sh scripts/runpod-preflight.sh scripts/runpod-warmup.sh

EXPOSE 5173 8787 8788 8101 8102 8103 8104 8105

HEALTHCHECK --interval=20s --timeout=5s --start-period=35s --retries=3 \
    CMD ["/opt/samevoice/docker/healthcheck.sh"]

ENTRYPOINT ["/usr/bin/tini", "--", "/opt/samevoice/docker/entrypoint.sh"]
