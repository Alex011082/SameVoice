{
  "name": "speakeasy-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SpeakEasy Stage 0 control plane: users, contacts, call-mode decision, LiveKit token minting, agent dispatch.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/smoke.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "dotenv": "17.4.2",
    "fastify": "5.12.1",
    "livekit-server-sdk": "2.18.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
