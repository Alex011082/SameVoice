# Extended R&D profile: Stage-1 THINK services + batch Chatterbox TTS A/B.
# Use only with an image built with INSTALL_GPU_ENGINES=1 and INSTALL_TTS_ENGINE=1.
# This is NOT the low-latency production TTS profile; Chatterbox's current
# integration here returns a completed waveform before audio is yielded.

WORKSPACE_ROOT=/workspace
EXPECTED_GPU_COUNT=2
SAMEVOICE_START_AGENT=1
SAMEVOICE_START_BACKEND=1
SAMEVOICE_START_WEB=1
SAMEVOICE_BOOTSTRAP_MOCK_ENV=0

ACOUSTIC_CUDA_VISIBLE_DEVICES=0
PREDICTOR_CUDA_VISIBLE_DEVICES=0
LOCAL_MT_CUDA_VISIBLE_DEVICES=0
TTS_CUDA_VISIBLE_DEVICES=1

ACOUSTIC_SCOUT_CMD=
PREDICTOR_CMD=PYTHONPATH=/opt/samevoice /opt/venvs/think/bin/python -m uvicorn gpu.predictor.app:app --host 127.0.0.1 --port 8101
LOCAL_MT_CMD=PYTHONPATH=/opt/samevoice /opt/venvs/think/bin/python -m uvicorn gpu.mt.app:app --host 127.0.0.1 --port 8103
LOCAL_TTS_CMD=PYTHONPATH=/opt/samevoice /opt/venvs/speak/bin/python -m uvicorn gpu.tts.app:app --host 127.0.0.1 --port 8104

PREDICTOR_URL=http://127.0.0.1:8101
LOCAL_MT_URL=http://127.0.0.1:8103
RUNPOD_MT_URL=http://127.0.0.1:8103
ACOUSTIC_SCOUT_URL=http://127.0.0.1:8102
LOCAL_TTS_URL=http://127.0.0.1:8104
RUNPOD_TTS_URL=http://127.0.0.1:8104

PREDICTOR_MODEL=Qwen/Qwen3-0.6B-Base
LOCAL_MT_MODEL_RU_HE=Helsinki-NLP/opus-mt-ru-he
LOCAL_MT_MODEL_HE_RU=Helsinki-NLP/opus-mt-he-ru
LOCAL_TTS_VOICE_ROOT=/workspace/voices

MODEL_DIR=/workspace/models
CHECKPOINT_DIR=/workspace/checkpoints
DATASET_DIR=/workspace/datasets
BENCHMARK_DIR=/workspace/benchmarks
HF_HOME=/workspace/hf-cache
TORCH_HOME=/workspace/torch-cache
XDG_CACHE_HOME=/workspace/cache
UV_CACHE_DIR=/workspace/uv-cache
CALL_ARCHIVE_DIR=/workspace/logs/archive
EVAL_LOG_DIR=/workspace/logs/calls
