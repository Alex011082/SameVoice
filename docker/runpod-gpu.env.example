# SameVoice Stage-1/2 GPU benchmark profile.
#
# Use only with an image built using INSTALL_GPU_ENGINES=1. Secrets still come
# from RunPod Secrets/environment. This file contains no credentials.

WORKSPACE_ROOT=/workspace
EXPECTED_GPU_COUNT=2
SAMEVOICE_START_AGENT=1
SAMEVOICE_START_BACKEND=1
SAMEVOICE_START_WEB=1
SAMEVOICE_BOOTSTRAP_MOCK_ENV=0

# Physical cards are exposed to each child process separately. Inside each
# service its selected physical card becomes cuda:0.
ACOUSTIC_CUDA_VISIBLE_DEVICES=0
ACOUSTIC_PRUNER_CUDA_VISIBLE_DEVICES=0
PREDICTOR_CUDA_VISIBLE_DEVICES=0
LOCAL_MT_CUDA_VISIBLE_DEVICES=0
TTS_CUDA_VISIBLE_DEVICES=1

# GPU0 R&D services. Running them does NOT automatically select them for live
# calls: STT_PROVIDER/MT_PROVIDER remain explicit A/B switches in the agent.
ACOUSTIC_SCOUT_CMD=PYTHONPATH=/opt/samevoice /opt/venvs/think/bin/python -m uvicorn gpu.acoustic.app:app --host 127.0.0.1 --port 8102
ACOUSTIC_PRUNER_CMD=PYTHONPATH=/opt/samevoice /opt/venvs/think/bin/python -m uvicorn gpu.acoustic.prune_app:app --host 127.0.0.1 --port 8105
PREDICTOR_CMD=PYTHONPATH=/opt/samevoice /opt/venvs/think/bin/python -m uvicorn gpu.predictor.app:app --host 127.0.0.1 --port 8101
LOCAL_MT_CMD=PYTHONPATH=/opt/samevoice /opt/venvs/think/bin/python -m uvicorn gpu.mt.app:app --host 127.0.0.1 --port 8103
LOCAL_TTS_CMD=

PREDICTOR_URL=http://127.0.0.1:8101
LOCAL_MT_URL=http://127.0.0.1:8103
RUNPOD_MT_URL=http://127.0.0.1:8103
ACOUSTIC_SCOUT_URL=http://127.0.0.1:8102
ACOUSTIC_PRUNER_URL=http://127.0.0.1:8105
RUNPOD_STT_URL=http://127.0.0.1:8102
LOCAL_TTS_URL=http://127.0.0.1:8104
RUNPOD_TTS_URL=http://127.0.0.1:8104

# Rolling next-source-word predictor SHADOW mode. The predictor observes the
# selected STT stream and writes Top-K/rank/sttLeadMs records, but it cannot
# alter MT, TTS, subtitles or audible output. This is the safe first live gate.
PREDICTOR_SHADOW_ENABLED=1
PREDICTOR_TOP_K=20
PREDICTOR_MIN_PREFIX_WORDS=3
PREDICTOR_TIMEOUT_MS=600

# Stage-2 acoustic re-ranker. The standalone :8105 API remains usable for exact
# word-onset component tests. Live shadow additionally samples every third
# linguistic prediction, taps the real 16 kHz PCM after the predictor arm, and
# records arm-relative +50/+100/+150/+200/+250 ms rankings. It remains read-only:
# no candidate is removed from the live translator and no audio commit changes.
ACOUSTIC_PRUNER_RU_MODEL=bond005/wav2vec2-base-ru
ACOUSTIC_PRUNER_HE_MODEL=imvladikon/wav2vec2-large-xlsr-53-hebrew
ACOUSTIC_PRUNER_SHADOW_ENABLED=1
ACOUSTIC_PRUNER_SHADOW_EVERY_N=3
ACOUSTIC_PRUNER_SHADOW_WINDOWS_MS=50,100,150,200,250
ACOUSTIC_PRUNER_TIMEOUT_MS=1500

# To route an actual translated call through local components, set these only
# for the intended A/B run (for example through /workspace/config/samevoice.env):
# STT_PROVIDER=runpod
# MT_PROVIDER=runpod
# TTS_PROVIDER=cartesia
#
# Keeping TTS_PROVIDER=cartesia preserves the already-selected RU/HE Cartesia
# voices while local TTS stays an explicit A/B experiment on GPU1.

# First-benchmark model ids. Override only for explicit A/B runs.
PREDICTOR_MODEL=Qwen/Qwen3-0.6B-Base
LOCAL_MT_MODEL_RU_HE=Helsinki-NLP/opus-mt-ru-he
LOCAL_MT_MODEL_HE_RU=Helsinki-NLP/opus-mt-he-ru
ACOUSTIC_RU_MODEL=nvidia/nemotron-3.5-asr-streaming-0.6b
ACOUSTIC_HE_MODEL=ivrit-ai/whisper-large-v3-turbo-ct2
ACOUSTIC_NEMOTRON_LOOKAHEAD=3
ACOUSTIC_VAD_POOL_SIZE=2
ACOUSTIC_VAD_THRESHOLD=0.5
ACOUSTIC_VAD_MIN_SILENCE_MS=180
ACOUSTIC_VAD_SPEECH_PAD_MS=40
ACOUSTIC_PRE_ROLL_MS=320
ACOUSTIC_HE_PARTIAL_INTERVAL_MS=480
ACOUSTIC_HE_PARTIAL_MIN_AUDIO_MS=700

# Persistent caches/data. Model downloads happen here, not in the image layer.
MODEL_DIR=/workspace/models
CHECKPOINT_DIR=/workspace/checkpoints
DATASET_DIR=/workspace/datasets
BENCHMARK_DIR=/workspace/benchmarks
HF_HOME=/workspace/hf-cache
TORCH_HOME=/workspace/torch-cache
XDG_CACHE_HOME=/workspace/cache
UV_CACHE_DIR=/workspace/uv-cache
CALL_ARCHIVE_DIR=/workspace/logs/archive
EVAL_LOG_DIR=/workspace/logs/calls
