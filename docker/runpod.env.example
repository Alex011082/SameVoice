# Non-secret RunPod runtime template for SameVoice R&D.
# Secrets (LiveKit/API keys) should be injected with RunPod Secrets/environment,
# never committed here or copied into the image.

WORKSPACE_ROOT=/workspace
EXPECTED_GPU_COUNT=2

# Core services included in the image.
SAMEVOICE_START_AGENT=1
SAMEVOICE_START_BACKEND=1
SAMEVOICE_START_WEB=1

# Only set to 1 for a keyless local/mock smoke run. Leave 0 on a real Pod.
SAMEVOICE_BOOTSTRAP_MOCK_ENV=0

# Optional persistent non-secret runtime settings file.
SAMEVOICE_CONFIG_FILE=/workspace/config/samevoice.env

# Service-parallel GPU allocation. RTX 4090 cards remain separate 24 GB devices;
# this configuration does not pretend they are one unified 48 GB GPU.
ACOUSTIC_CUDA_VISIBLE_DEVICES=0
PREDICTOR_CUDA_VISIBLE_DEVICES=0
LOCAL_MT_CUDA_VISIBLE_DEVICES=0
TTS_CUDA_VISIBLE_DEVICES=1

# Local engines are not committed yet. When their commands exist, the container
# entrypoint will launch them on the GPU above before starting agent/backend/web.
ACOUSTIC_SCOUT_CMD=
PREDICTOR_CMD=
LOCAL_MT_CMD=
LOCAL_TTS_CMD=

# Persistent caches/data.
MODEL_DIR=/workspace/models
CHECKPOINT_DIR=/workspace/checkpoints
DATASET_DIR=/workspace/datasets
BENCHMARK_DIR=/workspace/benchmarks
HF_HOME=/workspace/hf-cache
TORCH_HOME=/workspace/torch-cache
XDG_CACHE_HOME=/workspace/cache
UV_CACHE_DIR=/workspace/uv-cache
CALL_ARCHIVE_DIR=/workspace/logs/archive
EVAL_LOG_DIR=/workspace/logs/calls

# Local service endpoints reserved for the speculative runtime.
PREDICTOR_URL=http://127.0.0.1:8101
ACOUSTIC_SCOUT_URL=http://127.0.0.1:8102
LOCAL_MT_URL=http://127.0.0.1:8103
LOCAL_TTS_URL=http://127.0.0.1:8104
